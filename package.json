{
  "name": "siwc-image-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "test": "pnpm --filter server test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0"
}
